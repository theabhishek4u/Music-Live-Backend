# Syncora Backend Environment Example
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# DATABASE_URL: Transaction pooled connection string (typically port 6543 for Supabase connection pooler with Pgbouncer)
# Append '?pgbouncer=true&connection_limit=1' to configure Prisma connection pooling correctly
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Direct database connection string (typically port 5432) used for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
